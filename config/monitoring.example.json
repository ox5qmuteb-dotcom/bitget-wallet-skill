{
  "default_alerts": {
    "inactivity_seconds": 86400,
    "large_value_threshold": "10000"
  },
  "providers": [
    {
      "name": "eth-rpc",
      "type": "evm_rpc",
      "chain": "eth",
      "rpc_url_env": "ETH_RPC_URL",
      "timeout_seconds": 10,
      "retries": 2
    },
    {
      "name": "base-rpc",
      "type": "evm_rpc",
      "chain": "base",
      "rpc_url_env": "BASE_RPC_URL",
      "timeout_seconds": 10,
      "retries": 2
    },
    {
      "name": "sol-rpc",
      "type": "solana_rpc",
      "chain": "sol",
      "rpc_url_env": "SOLANA_RPC_URL",
      "timeout_seconds": 10,
      "retries": 2
    },
    {
      "name": "bitget-price",
      "type": "bitget_price",
      "base_url": "https://copenapi.bgwapi.io",
      "timeout_seconds": 10,
      "retries": 2
    }
  ],
  "wallets": [
    {
      "name": "Treasury ETH",
      "network": "Ethereum",
      "chain": "eth",
      "token": "ETH",
      "address": "0x1111111111111111111111111111111111111111",
      "provider": "eth-rpc",
      "alerts": {
        "min_balance": "0.50"
      }
    },
    {
      "name": "Operations USDC",
      "network": "Base",
      "chain": "base",
      "token": "USDC",
      "contract": "0x2222222222222222222222222222222222222222",
      "address": "0x1111111111111111111111111111111111111111",
      "provider": "base-rpc",
      "price_provider": "bitget-price",
      "alerts": {
        "min_balance": "1000",
        "max_balance": "500000",
        "large_transaction_value": "10000"
      }
    },
    {
      "name": "Treasury SOL",
      "network": "Solana",
      "chain": "sol",
      "token": "SOL",
      "address": "11111111111111111111111111111111",
      "provider": "sol-rpc",
      "alerts": {
        "inactivity_seconds": 43200
      }
    }
  ]
}
